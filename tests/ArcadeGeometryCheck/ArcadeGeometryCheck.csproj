<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads the user's installed Schedule I level1 READ-ONLY (path passed on the command line),
       measures the Arcade building colliders and checks that the walk-in entrance is walkable.
       No game data is copied into this repository. Uses the AssetsTools.NET that ships with
       MelonLoader 0.7.3 in the game folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <ScheduleIGameDir Condition="'$(ScheduleIGameDir)' == ''">D:\SteamLibrary\steamapps\common\Schedule I</ScheduleIGameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\ScheduleIArcade\Utils\ArcadeLayout.cs" Link="Shared\ArcadeLayout.cs" />
    <Compile Include="..\..\src\ScheduleIArcade\Utils\ArcadeDimensions.cs" Link="Shared\ArcadeDimensions.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AssetsTools.NET"><HintPath>$(ScheduleIGameDir)\MelonLoader\net6\AssetsTools.NET.dll</HintPath></Reference>
  </ItemGroup>
</Project>
