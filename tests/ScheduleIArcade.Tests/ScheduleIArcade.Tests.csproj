<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless regression checks for pure-managed mod logic. No NuGet packages are used so the
       suite builds offline with any installed .NET SDK; run with `dotnet run -c Release`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <RootNamespace>ScheduleIArcade.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\ScheduleIArcade\Games\Pinball\PinballSimulation.cs" Link="Shared\PinballSimulation.cs" />
    <Compile Include="..\..\src\ScheduleIArcade\Utils\ArcadeAudioMath.cs" Link="Shared\ArcadeAudioMath.cs" />
    <Compile Include="..\..\src\ScheduleIArcade\Utils\ModFiles.cs" Link="Shared\ModFiles.cs" />
    <Compile Include="..\..\src\ScheduleIArcade\Utils\GlbMeshParser.cs" Link="Shared\GlbMeshParser.cs" />
    <Compile Include="..\..\src\ScheduleIArcade\Utils\LocalAssetManifest.cs" Link="Shared\LocalAssetManifest.cs" />
    <Compile Include="..\..\src\ScheduleIArcade\Games\Pacman\PacmanGhostAi.cs" Link="Shared\PacmanGhostAi.cs" />
    <Compile Include="..\..\src\ScheduleIArcade\Games\AirHockey\AirHockeySimulation.cs" Link="Shared\AirHockeySimulation.cs" />
  </ItemGroup>
</Project>
